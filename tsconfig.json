{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
	"baseUrl": "./",
	"paths": {
		"@components/*": ["src/components/*"],
		"@content/*": ["src/content/*"],
		"@schemas/*": ["src/schemas/*"],
		"@layouts/*": ["src/layouts/*"],
		"@pages/*": ["src/pages/*"],
	}
  }
}
